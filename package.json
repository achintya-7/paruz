{
  "name": "paruz",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "build": "rm -rf dist && bun build --minify --target=bun src/index.tsx --outdir=dist && printf '%s\\n%s' '#!/usr/bin/env bun' \"$(cat dist/index.js)\" > dist/paruz && chmod +x dist/paruz && rm dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@opentui/react": "^0.3.2",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  }
}
